{
  "name": "musicdl.downloader",
  "label": "下载器",
  "kind": "tool",
  "version": "1.0.0",
  "hint": "聚合多平台音乐搜索与下载（网易云/QQ/酷狗/酷我/咪咕等）",
  "entries": {
    "windows": "bin/run.cmd",
    "linux": "bin/run.sh",
    "darwin": "bin/run.sh"
  },
  "panel": "ui/index.html",
  "fields": [
    { "key": "default_dir", "label": "默认下载目录", "type": "text", "placeholder": "留空则自动读取宿主默认音乐目录" },
    { "key": "netease_cookie", "label": "网易云 Cookie", "type": "password", "placeholder": "可选，下载 VIP 歌曲时填写" },
    { "key": "qq_cookie", "label": "QQ音乐 Cookie", "type": "password", "placeholder": "可选" },
    { "key": "kugou_cookie", "label": "酷狗 Cookie", "type": "password", "placeholder": "可选" },
    { "key": "kuwo_cookie", "label": "酷我 Cookie", "type": "password", "placeholder": "可选" },
    { "key": "migu_cookie", "label": "咪咕 Cookie", "type": "password", "placeholder": "可选" }
  ]
}
